    const state = {
      index: 0,
      score: 0,
      visibility: 50,
      integrity: 50,
      data: 50,
      resistance: 50,
      selected: null,
      history: []
    };

    const refs = {
      stageCounter: document.getElementById("stageCounter"),
      personaLabel: document.getElementById("personaLabel"),
      scoreValue: document.getElementById("scoreValue"),
      moodValue: document.getElementById("moodValue"),
      stageSummary: document.getElementById("stageSummary"),
      conceptHint: document.getElementById("conceptHint"),
      stepTag: document.getElementById("stepTag"),
      scenarioTitle: document.getElementById("scenarioTitle"),
      scenarioBody: document.getElementById("scenarioBody"),
      choices: document.getElementById("choices"),
      resultBox: document.getElementById("resultBox"),
      nextButton: document.getElementById("nextButton"),
      microReflection: document.getElementById("microReflection"),
      progressFill: document.getElementById("progressFill"),
      playScreen: document.getElementById("playScreen"),
      endingScreen: document.getElementById("endingScreen"),
      endingTitle: document.getElementById("endingTitle"),
      endingBody: document.getElementById("endingBody"),
      endingTheory: document.getElementById("endingTheory"),
      journeyLog: document.getElementById("journeyLog"),
      finalStats: document.getElementById("finalStats"),
      restartButton: document.getElementById("restartButton"),
      visibilityValue: document.getElementById("visibilityValue"),
      integrityValue: document.getElementById("integrityValue"),
      dataValue: document.getElementById("dataValue"),
      resistanceValue: document.getElementById("resistanceValue"),
      visibilityBar: document.getElementById("visibilityBar"),
      integrityBar: document.getElementById("integrityBar"),
      dataBar: document.getElementById("dataBar"),
      resistanceBar: document.getElementById("resistanceBar")
    };

    function clamp(value) {
      return Math.max(0, Math.min(100, value));
    }

    function setMeter(bar, label, value) {
      const safe = clamp(value);
      bar.style.width = safe + "%";
      label.textContent = safe;
    }

    function derivePersona() {
      if (state.visibility > 75 && state.integrity < 45) {
        return "Markalaşmış Benlik";
      }
      if (state.resistance > 72 && state.data < 45) {
        return "Kaçak Profil";
      }
      if (state.integrity > 72 && state.visibility >= 45) {
        return "Eleştirel Persona";
      }
      if (state.data > 72 && state.visibility > 65) {
        return "Verileşmiş Öz";
      }
      return "Müzakere Halinde";
    }

    function deriveMood() {
      if (state.visibility >= 70 && state.integrity >= 60) {
        return "Parlak ama dengeli";
      }
      if (state.visibility >= 70 && state.integrity < 50) {
        return "Aşırı optimize";
      }
      if (state.resistance >= 70) {
        return "Temkinli";
      }
      if (state.data >= 70) {
        return "İz bırakıyor";
      }
      return "Kararsız";
    }

    function updateHud() {
      refs.stageCounter.textContent = `${Math.min(state.index + 1, scenarios.length)} / ${scenarios.length}`;
      refs.personaLabel.textContent = derivePersona();
      refs.scoreValue.textContent = state.score;
      refs.moodValue.textContent = deriveMood();

      setMeter(refs.visibilityBar, refs.visibilityValue, state.visibility);
      setMeter(refs.integrityBar, refs.integrityValue, state.integrity);
      setMeter(refs.dataBar, refs.dataValue, state.data);
      setMeter(refs.resistanceBar, refs.resistanceValue, state.resistance);

      refs.progressFill.style.width = `${(state.index / scenarios.length) * 100}%`;
    }

    function renderScenario() {
      const scenario = scenarios[state.index];
      refs.stepTag.textContent = scenario.tag;
      refs.scenarioTitle.textContent = scenario.title;
      refs.scenarioBody.textContent = scenario.body;
      refs.stageSummary.textContent = scenario.stageSummary;
      refs.conceptHint.textContent = scenario.conceptHint;
      refs.microReflection.textContent = scenario.reflection;
      refs.resultBox.className = "result-box";
      refs.resultBox.innerHTML = "<h3>Seçimini Bekliyor</h3><p>Bir kart seç. Sonuç bölümünde görünürlük, veri izi, benlik bütünlüğü ve direnç dengesi anında değişecek.</p>";
      refs.nextButton.disabled = true;
      refs.choices.innerHTML = "";
      state.selected = null;

      scenario.choices.forEach((choice, index) => {
        const button = document.createElement("button");
        button.className = "choice";
        button.innerHTML = `<span class="choice-title">${index + 1}. ${choice.title}</span><span class="choice-copy">${choice.text}</span>`;
        button.addEventListener("click", () => applyChoice(choice, index));
        refs.choices.appendChild(button);
      });

      updateHud();
    }

    function applyChoice(choice, choiceIndex) {
      if (state.selected !== null) {
        return;
      }

      state.selected = choiceIndex;
      state.score += choice.effect.score;
      state.visibility = clamp(state.visibility + choice.effect.visibility);
      state.integrity = clamp(state.integrity + choice.effect.integrity);
      state.data = clamp(state.data + choice.effect.data);
      state.resistance = clamp(state.resistance + choice.effect.resistance);

      state.history.push({
        stage: scenarios[state.index].title,
        choice: choice.title,
        text: choice.resultText
      });

      refs.resultBox.className = `result-box ${choice.tone}`;
      refs.resultBox.innerHTML = `<h3>${choice.resultTitle}</h3><p>${choice.resultText}</p>`;
      refs.nextButton.disabled = false;

      Array.from(refs.choices.children).forEach((button, index) => {
        button.disabled = true;
        if (index === choiceIndex) {
          button.style.boxShadow = "0 0 0 2px rgba(29, 53, 87, 0.18), 0 18px 32px rgba(29, 53, 87, 0.12)";
        }
      });

      updateHud();
    }

    function computeEnding() {
      if (state.visibility >= 80 && state.integrity <= 42) {
        return {
          title: "Sonuç: Algoritmanın Gözdesi",
          body: "Yüksek görünürlük kazandın ama dijital benliğin giderek tek boyutlu ve sürekli optimize edilen bir ürüne dönüştü. Sen konuşurken bile metrikler senin yerine karar vermeye başladı.",
          theory: "Bu final, benliğin platform mantığı içinde markalaşarak daralmasını gösteriyor. Kimlik burada sabit bir öz değil; dolaşım için törpülenmiş, veri açısından verimli hale getirilmiş bir paket."
        };
      }

      if (state.integrity >= 72 && state.resistance >= 68) {
        return {
          title: "Sonuç: Eleştirel Öznenin Rotası",
          body: "Tam görünmez olmadın; ama hiçbir zaman bütünüyle platformun ritmine teslim de olmadın. Sınır koydun, biçimleri dönüştürdün ve kendini yalnızca performansa indirmeden var olabildin.",
          theory: "Bu rota, fabrikasyonu tamamen yok etmiyor; onun farkına varıp onunla müzakere ediyor. Dijital benlik burada hem kurulan hem de sorgulanan bir süreç."
        };
      }

      if (state.data <= 38 && state.resistance >= 78) {
        return {
          title: "Sonuç: Dağıtık ve Kaçak Benlik",
          body: "Daha az ölçülebilir, daha az merkezileşmiş bir profil inşa ettin. Görünürlüğün düştü ama tek bir platformun kimlik fabrikasına bütünüyle teslim olmadın.",
          theory: "Bu final, dijital öznenin büyük platform merkezliliğinden kaçışını işaret ediyor. Kimlik bir merkezde sabitlenmek yerine farklı alanlara dağılarak korunuyor."
        };
      }

      return {
        title: "Sonuç: Müzakere Halindeki Persona",
        body: "Ne tamamen sistemin ürünü oldun ne de ondan bütünüyle çıktın. Çelişkiler taşıyan, bazen uyumlanan bazen direnen bir dijital benlik kurdun.",
        theory: "Dersin ana fikrine en yakın ara bölge burası: dijital kimlik çoğu zaman saf özgürlük ya da tam tahakküm değil, ikisi arasında gidip gelen bir kurulum pratiğidir."
      };
    }

    function renderEnding() {
      const ending = computeEnding();
      refs.playScreen.style.display = "none";
      refs.endingScreen.classList.add("active");
      refs.endingTitle.textContent = ending.title;
      refs.endingBody.textContent = ending.body;
      refs.endingTheory.textContent = ending.theory;
      refs.stageCounter.textContent = `${scenarios.length} / ${scenarios.length}`;
      refs.progressFill.style.width = "100%";
      refs.stageSummary.textContent = "Oyun tamamlandı. Şimdi ürettiğin dijital personanın hangi mantıkla biçimlendiğine bak.";
      refs.conceptHint.textContent = "Final yorumunda görünürlük, veri, bütünlük ve direnç arasındaki ilişki doğrudan ders kavramlarına bağlanıyor.";

      refs.finalStats.innerHTML = "";
      [
        ["Görünürlük", state.visibility],
        ["Benlik Bütünlüğü", state.integrity],
        ["Veri İzi", state.data],
        ["Direnç", state.resistance],
        ["Toplam Skor", state.score]
      ].forEach(([label, value]) => {
        const item = document.createElement("article");
        item.className = "log-item";
        item.innerHTML = `<strong>${label}</strong><p>${value}</p>`;
        refs.finalStats.appendChild(item);
      });

      refs.journeyLog.innerHTML = "";
      state.history.forEach((entry, index) => {
        const item = document.createElement("article");
        item.className = "log-item";
        item.innerHTML = `<strong>${index + 1}. ${entry.stage} → ${entry.choice}</strong><p>${entry.text}</p>`;
        refs.journeyLog.appendChild(item);
      });

      updateHud();
    }

    refs.nextButton.addEventListener("click", () => {
      if (state.selected === null) {
        return;
      }

      state.index += 1;
      if (state.index >= scenarios.length) {
        renderEnding();
        return;
      }

      renderScenario();
    });

    refs.restartButton.addEventListener("click", () => {
      state.index = 0;
      state.score = 0;
      state.visibility = 50;
      state.integrity = 50;
      state.data = 50;
      state.resistance = 50;
      state.selected = null;
      state.history = [];

      refs.playScreen.style.display = "block";
      refs.endingScreen.classList.remove("active");
      renderScenario();
    });

    renderScenario();
  </script>
