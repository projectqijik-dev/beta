<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Benlik Fabrikası</title>
  <style>
    :root {
      --bg: #f4efe7;
      --paper: rgba(255, 250, 244, 0.84);
      --ink: #1e2432;
      --muted: #5b6475;
      --plum: #7f2f59;
      --brick: #c8553d;
      --amber: #e9b44c;
      --teal: #2d7d7a;
      --navy: #1d3557;
      --line: rgba(30, 36, 50, 0.1);
      --shadow: 0 24px 70px rgba(29, 53, 87, 0.14);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Avenir Next", "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(233, 180, 76, 0.3), transparent 28%),
        radial-gradient(circle at 85% 15%, rgba(127, 47, 89, 0.18), transparent 22%),
        radial-gradient(circle at 20% 100%, rgba(45, 125, 122, 0.17), transparent 28%),
        linear-gradient(135deg, #f7f1e7 0%, #f0e1d1 48%, #eef2f4 100%);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(30, 36, 50, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30, 36, 50, 0.03) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent);
    }

    .app {
      width: min(1180px, calc(100% - 1.4rem));
      margin: 1rem auto 2rem;
      position: relative;
      z-index: 1;
      display: grid;
      gap: 1rem;
    }

    .panel,
    .hero {
      background: var(--paper);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      border-radius: 28px;
    }

    .hero {
      overflow: hidden;
      position: relative;
      padding: 1.4rem;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -3rem;
      top: -4rem;
      width: 260px;
      height: 260px;
      background: radial-gradient(circle, rgba(127, 47, 89, 0.24), transparent 70%);
      border-radius: 50%;
    }

    .hero-top {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 1rem;
      align-items: start;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.38rem 0.84rem;
      border-radius: 999px;
      background: rgba(29, 53, 87, 0.08);
      color: var(--navy);
      font-size: 0.9rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0.7rem 0 0.55rem;
      font-size: clamp(2.2rem, 4.2vw, 4.6rem);
      line-height: 0.95;
      max-width: 10ch;
      letter-spacing: -0.04em;
    }

    .hero-copy {
      margin: 0;
      max-width: 62ch;
      line-height: 1.7;
      font-size: 1.02rem;
      color: var(--muted);
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(140px, 1fr));
      gap: 0.85rem;
    }

    .stat-card {
      padding: 1rem;
      border-radius: 22px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.5));
      border: 1px solid var(--line);
    }

    .stat-card span {
      font-size: 0.84rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .stat-card strong {
      display: block;
      margin-top: 0.35rem;
      font-size: 1.7rem;
    }

    .hero-bottom {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 1rem;
      margin-top: 1rem;
    }

    .signal,
    .manifesto {
      border-radius: 24px;
      padding: 1rem 1.1rem;
      color: #fff9f2;
      position: relative;
      overflow: hidden;
    }

    .signal {
      background: linear-gradient(135deg, #14213d, #274c77);
    }

    .manifesto {
      background: linear-gradient(135deg, #7f2f59, #b56576);
    }

    .signal::after,
    .manifesto::after {
      content: "";
      position: absolute;
      right: -30px;
      bottom: -36px;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .signal h2,
    .manifesto h2,
    .panel h2 {
      margin: 0 0 0.45rem;
      font-size: 1.06rem;
    }

    .signal p,
    .manifesto p,
    .result-box p,
    .theory-card p {
      margin: 0;
      line-height: 1.65;
    }

    .progress-track {
      margin-top: 0.85rem;
      height: 12px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #e9b44c, #ffd98b);
      transition: width 0.35s ease;
    }

    .layout {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 1rem;
    }

    .panel {
      padding: 1.25rem;
    }

    .step-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.36rem 0.7rem;
      border-radius: 999px;
      background: rgba(45, 125, 122, 0.12);
      color: var(--teal);
      font-size: 0.85rem;
      margin-bottom: 0.85rem;
    }

    .scenario-title {
      margin: 0 0 0.7rem;
      font-size: clamp(1.5rem, 2.6vw, 2.3rem);
      line-height: 1.08;
    }

    .scenario-body {
      margin: 0;
      font-size: 1.03rem;
      line-height: 1.8;
      color: #364055;
    }

    .choices {
      display: grid;
      gap: 0.85rem;
      margin-top: 1.1rem;
    }

    .choice {
      width: 100%;
      border: 0;
      border-radius: 22px;
      text-align: left;
      padding: 1rem 1rem 1rem 1.05rem;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 12px 28px rgba(29, 53, 87, 0.08);
      cursor: pointer;
      transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
    }

    .choice:hover,
    .choice:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 18px 32px rgba(29, 53, 87, 0.12);
      background: #fffdf8;
      outline: none;
    }

    .choice:disabled {
      cursor: default;
      opacity: 0.72;
    }

    .choice-title {
      display: block;
      font-weight: 800;
      font-size: 1rem;
      margin-bottom: 0.28rem;
      color: var(--ink);
    }

    .choice-copy {
      display: block;
      color: var(--muted);
      line-height: 1.6;
      font-size: 0.95rem;
    }

    .result-box {
      margin-top: 1rem;
      min-height: 138px;
      border-radius: 22px;
      padding: 1rem;
      background: linear-gradient(180deg, rgba(255, 253, 248, 0.85), rgba(255, 255, 255, 0.95));
      border: 1px solid var(--line);
    }

    .result-box.good {
      background: linear-gradient(180deg, rgba(45, 125, 122, 0.14), rgba(255, 255, 255, 0.95));
      border-color: rgba(45, 125, 122, 0.26);
    }

    .result-box.warn {
      background: linear-gradient(180deg, rgba(200, 85, 61, 0.13), rgba(255, 255, 255, 0.95));
      border-color: rgba(200, 85, 61, 0.25);
    }

    .result-box h3 {
      margin: 0 0 0.45rem;
      font-size: 1rem;
    }

    .action-row {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .primary-btn,
    .secondary-btn {
      border: 0;
      border-radius: 999px;
      padding: 0.9rem 1.2rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--brick), #a83b25);
      color: white;
      box-shadow: 0 14px 24px rgba(168, 59, 37, 0.24);
    }

    .secondary-btn {
      background: rgba(29, 53, 87, 0.08);
      color: var(--navy);
    }

    .primary-btn:hover,
    .secondary-btn:hover,
    .primary-btn:focus-visible,
    .secondary-btn:focus-visible {
      transform: translateY(-2px);
      outline: none;
    }

    .primary-btn:disabled {
      opacity: 0.45;
      box-shadow: none;
      cursor: not-allowed;
      transform: none;
    }

    .meta-text {
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.6;
    }

    .sidebar {
      display: grid;
      gap: 1rem;
    }

    .meter-list,
    .theory-list,
    .log-list {
      display: grid;
      gap: 0.8rem;
    }

    .meter-card,
    .theory-card,
    .log-item {
      border-radius: 20px;
      padding: 0.95rem;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid var(--line);
    }

    .meter-head {
      display: flex;
      justify-content: space-between;
      gap: 0.8rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
    }

    .meter-track {
      height: 10px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(29, 53, 87, 0.1);
    }

    .meter-fill {
      height: 100%;
      transition: width 0.35s ease;
    }

    .theory-card strong,
    .log-item strong {
      display: block;
      margin-bottom: 0.3rem;
      font-size: 0.96rem;
    }

    .log-item p {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      font-size: 0.92rem;
    }

    .ending {
      display: none;
      gap: 1rem;
    }

    .ending.active {
      display: grid;
    }

    .ending-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }

    .ending-card {
      border-radius: 22px;
      padding: 1.05rem;
      background: linear-gradient(145deg, rgba(233, 180, 76, 0.16), rgba(255, 255, 255, 0.95));
      border: 1px solid var(--line);
    }

    .footer-note {
      font-size: 0.92rem;
      color: var(--muted);
    }

    @media (max-width: 920px) {
      .hero-top,
      .hero-bottom,
      .layout,
      .ending-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .app {
        width: min(100% - 0.8rem, 1180px);
      }

      .hero,
      .panel {
        padding: 1rem;
        border-radius: 22px;
      }

      .stat-grid {
        grid-template-columns: 1fr 1fr;
      }

      .action-row {
        align-items: stretch;
      }

      .primary-btn,
      .secondary-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <section class="hero">
      <div class="hero-top">
        <div>
          <span class="eyebrow">Dijital Kültürler · Kimlik Deneyi</span>
          <h1>Benlik Fabrikası</h1>
          <p class="hero-copy">
            Bu HTML oyun, “kimlik” ve “dijital benliğin fabrikasyonu” eksenindeki dersi etkileşimli hale getirir.
            Her turda platformun senden istediği performans ile kendi bütünlüğünü koruma arzun arasında seçim yapacaksın.
            Hedefin yalnızca görünür olmak değil; veri izini, kırılganlığını ve öz-benliğini de yönetebilmek.
          </p>
        </div>

        <div class="stat-grid">
          <article class="stat-card">
            <span>Bölüm</span>
            <strong id="stageCounter">1 / 6</strong>
          </article>
          <article class="stat-card">
            <span>Profil Tipi</span>
            <strong id="personaLabel">Taslak Benlik</strong>
          </article>
          <article class="stat-card">
            <span>Toplam Skor</span>
            <strong id="scoreValue">0</strong>
          </article>
          <article class="stat-card">
            <span>Durum</span>
            <strong id="moodValue">Kararsız</strong>
          </article>
        </div>
      </div>

      <div class="hero-bottom">
        <section class="signal">
          <h2>Algoritmik Baskı</h2>
          <p id="stageSummary">Platform sana ilk soruyu yöneltiyor: görünür olmak için ne kadarını paketleyeceksin?</p>
          <div class="progress-track" aria-hidden="true">
            <div class="progress-fill" id="progressFill"></div>
          </div>
        </section>

        <section class="manifesto">
          <h2>Ders İzi</h2>
          <p id="conceptHint">Kimlik burada sabit bir öz değil; dolaşıma sokulan, optimize edilen ve sürekli yeniden kurulan bir performans alanı.</p>
        </section>
      </div>
    </section>

    <section class="layout">
      <section class="panel">
        <div id="playScreen">
          <span class="step-tag" id="stepTag">Aşama 1 · Giriş</span>
          <h2 class="scenario-title" id="scenarioTitle"></h2>
          <p class="scenario-body" id="scenarioBody"></p>

          <div class="choices" id="choices"></div>

          <div class="result-box" id="resultBox">
            <h3>Seçimini Bekliyor</h3>
            <p>Bir kart seç. Sonuç bölümünde görünürlük, veri izi, benlik bütünlüğü ve direnç dengesi anında değişecek.</p>
          </div>

          <div class="action-row">
            <span class="meta-text" id="microReflection">Dijital kültürde her seçim, aynı anda bir ifade biçimi ve bir ölçülebilir veri üretir.</span>
            <button class="primary-btn" id="nextButton" disabled>Sonraki Aşamaya Geç</button>
          </div>
        </div>

        <div class="ending" id="endingScreen">
          <div class="ending-card">
            <span class="step-tag">Final · Benlik Raporu</span>
            <h2 class="scenario-title" id="endingTitle">Sonuç</h2>
            <p class="scenario-body" id="endingBody"></p>
          </div>

          <div class="ending-grid">
            <article class="ending-card">
              <h2>Okuma Anahtarı</h2>
              <p id="endingTheory"></p>
            </article>
            <article class="ending-card">
              <h2>Son Sayaçlar</h2>
              <div class="log-list" id="finalStats"></div>
            </article>
          </div>

          <div class="ending-card">
            <h2>Yolculuk Günlüğü</h2>
            <div class="log-list" id="journeyLog"></div>
          </div>

          <div class="action-row">
            <span class="footer-note">İstersen aynı dersi bu kez başka bir stratejiyle oynayıp tamamen farklı bir dijital persona üretebilirsin.</span>
            <button class="secondary-btn" id="restartButton">Baştan Oyna</button>
          </div>
        </div>
      </section>

      <aside class="sidebar">
        <section class="panel">
          <h2>Kimlik Sayaçları</h2>
          <div class="meter-list">
            <article class="meter-card">
              <div class="meter-head">
                <span>Görünürlük</span>
                <span id="visibilityValue">50</span>
              </div>
              <div class="meter-track"><div class="meter-fill" id="visibilityBar" style="background:#c8553d;"></div></div>
            </article>
            <article class="meter-card">
              <div class="meter-head">
                <span>Benlik Bütünlüğü</span>
                <span id="integrityValue">50</span>
              </div>
              <div class="meter-track"><div class="meter-fill" id="integrityBar" style="background:#2d7d7a;"></div></div>
            </article>
            <article class="meter-card">
              <div class="meter-head">
                <span>Veri İzi</span>
                <span id="dataValue">50</span>
              </div>
              <div class="meter-track"><div class="meter-fill" id="dataBar" style="background:#e9b44c;"></div></div>
            </article>
            <article class="meter-card">
              <div class="meter-head">
                <span>Direnç</span>
                <span id="resistanceValue">50</span>
              </div>
              <div class="meter-track"><div class="meter-fill" id="resistanceBar" style="background:#1d3557;"></div></div>
            </article>
          </div>
        </section>

        <section class="panel">
          <h2>Dersin Kavramları</h2>
          <div class="theory-list">
            <article class="theory-card">
              <strong>Performans Olarak Kimlik</strong>
              <p>Dijital benlik, yalnızca “kim olduğun” değil; nasıl göründüğün, nasıl ölçüldüğün ve nasıl dolaşıma girdiğinle de kurulur.</p>
            </article>
            <article class="theory-card">
              <strong>Platform Mantığı</strong>
              <p>Algoritmalar seni ifade etmene izin verirken aynı anda seni biçimlendirir; seçenek sunar ama tercihlerini öngörülebilir kalıplara iter.</p>
            </article>
            <article class="theory-card">
              <strong>Fabrikasyon</strong>
              <p>Benlik burada doğal bir öz değil; seçilen filtreler, tekrar eden jestler, veri akışı ve görünürlük ekonomisi içinde üretilen bir kurgu.</p>
            </article>
          </div>
        </section>
      </aside>
    </section>
  </main>

  <script>
    const scenarios = [
      {
        tag: "Aşama 1 · Giriş",
        title: "Platforma İlk Adımını Atıyorsun",
        body: "Yeni bir hesap açtın. Sistem senden kısa bir biyografi, bir profil fotoğrafı ve seni kategorize edecek birkaç ilgi alanı istiyor. Daha ilk anda hangi parçanı dolaşıma sokacağına karar vermen gerekiyor.",
