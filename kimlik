          },
          {
            title: "Katmanlı ve esnek bir profil oluştur",
            text: "Sabit bir slogan yerine açık uçlu bir tanım yaz, tek bir estetiğe kapanma.",
            effect: { visibility: 8, integrity: 14, data: 4, resistance: 10, score: 18 },
            tone: "good",
            resultTitle: "Daha yavaş ama daha geniş bir alan",
            resultText: "Algoritma seni hemen paketleyemedi; bu da görünürlüğü biraz yavaşlattı ama hareket alanını artırdı."
