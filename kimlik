            text: "Yavaş, kişisel ve platform estetiğine meydan okuyan bir dil seç.",
            effect: { visibility: -6, integrity: 16, data: -2, resistance: 14, score: 16 },
            tone: "good",
            resultTitle: "Düşük hız, yüksek özgünlük",
            resultText: "İzleyici kitlen daha dar kaldı; ama söylem biçimin daha az kolonize oldu."
